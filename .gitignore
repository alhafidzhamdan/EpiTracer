# History files
.Rhistory
.Rapp.history
# Session Data files
.RData
.RDataTmp
# User-specific files
.Ruserdata
# Example code in package build process
*-Ex.R
# Output files from R CMD build / check
/*.tar.gz
/*.Rcheck/
# RStudio files
.Rproj.user/
*.Rproj
# produced vignettes
vignettes/*.html
vignettes/*.pdf
# OAuth2 tokens
.httr-oauth
# knitr / rmarkdown temp
*_cache/
/cache/
# macOS
.DS_Store
# pkgdown site output (hand-written docs/*.md are tracked)
/docs/*.html
/docs/**/*.html
# scratch outputs
*.pdf

# large dev data / references (bundle a small subset later)
example_data/
references/

# validation run outputs (regenerated by the scripts)
validation/output/
pkgdown-site/
figure/
