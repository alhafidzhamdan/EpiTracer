    given-names: Alhafidz
    email: alhafidz.hamdan@ed.ac.uk
repository-code: "https://github.com/alhafidzhamdan/EpiTracer"
url: "https://alhafidzhamdan.github.io/EpiTracer"
license: MIT
version: 0.0.0.9000
date-released: "2026-08-14"
keywords:
  - ecDNA
  - extrachromosomal DNA
  - episome
  - structural variants
  - copy number
  - cancer genomics
  - whole-genome sequencing
